# Optional. Without this set, the API uses a local mock analysis so the
# project runs and is fully demoable without any API key or credentials.
OPENAI_API_KEY=

# Optional. Path to a Firebase service account JSON file. Without this set,
# analyses are saved to a local JSON file (local_data/analyses.json) instead
# of real Firestore, with the exact same read/write interface.
FIREBASE_CREDENTIALS_PATH=
